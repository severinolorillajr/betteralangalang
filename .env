# Public site configuration for Better Alangalang.
#
# Vite compiles every VITE_* value into the client bundle, so nothing secret
# belongs in this file. Secrets (Meilisearch keys, analytics IDs) go in
# .env.local, which stays gitignored.

VITE_GOVERNMENT_NAME="Alangalang"
VITE_GOVERNMENT_TYPE="Municipality"
VITE_REGION="Region VIII"
VITE_PROVINCE="Leyte"

VITE_WEBSITE_URL="https://betteralangalang.org"
VITE_SITE_DESCRIPTION="Community-built transparency portal for Alangalang, Leyte. Local government services, departments, budgets and contacts in one place."
VITE_SITE_KEYWORDS="Alangalang, Leyte, local government, transparency, public services"
VITE_OG_IMAGE_URL="https://betteralangalang.org/og-image.jpg"
